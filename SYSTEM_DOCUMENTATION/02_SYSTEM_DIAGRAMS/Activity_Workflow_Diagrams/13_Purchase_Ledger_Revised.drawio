<?xml version="1.0" encoding="UTF-8" standalone="yes"?><mxfile host="app.diagrams.net" agent="SiteTrace documentation revision" version="24.7.17" compressed="false" pages="1"><diagram id="13_Purchase_Ledger_Revised_P01" name="P1 · Record supplier purchase (separate from receipt)"><mxGraphModel dx="1500" dy="2180" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="2180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="annotation0" value="SITETRACE / MCPA" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=22;fontColor=#526578;" vertex="1" parent="1"><mxGeometry x="65" y="26" width="1370" height="32" as="geometry"/></mxCell><mxCell id="annotation1" value="Purchase ledger" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=40;fontColor=#153952;" vertex="1" parent="1"><mxGeometry x="65" y="58" width="1370" height="50" as="geometry"/></mxCell><mxCell id="annotation2" value="1 / 1  ·  Record supplier purchase (separate from receipt)" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=27;fontColor=#526578;" vertex="1" parent="1"><mxGeometry x="65" y="115" width="1370" height="37" as="geometry"/></mxCell><mxCell id="annotation3" value="Quantities use at most 3 decimals; unit prices at most 2. Ledger recording is independent of physical stock receipt." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#41556a;" vertex="1" parent="1"><mxGeometry x="65" y="2027" width="1370" height="33" as="geometry"/></mxCell><mxCell id="annotation4" value="Source-reviewed 071ae16 · 20 Oct 2026 · Main flow ↓ / branches → · Paired circles: same page / pentagons: named page" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#526578;" vertex="1" parent="1"><mxGeometry x="65" y="2141" width="1370" height="29" as="geometry"/></mxCell><mxCell id="p1n1" value="Start · Admin / Secretary records purchase" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=30;fontStyle=1;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="210" y="190" width="680" height="100" as="geometry"/></mxCell><mxCell id="p1n2" value="Enter supplier, reference, purchase date,&#xa;1–100 item lines, quantities / unit prices,&#xa;optional request link and private receipt." style="shape=parallelogram;fixedSize=1;size=36;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=30;fontStyle=0;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="170" y="343" width="760" height="151.8" as="geometry"/></mxCell><mxCell id="p1n3" value="Role, lines and optional&#xa;receipt reference valid?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=28;fontStyle=1;strokeColor=#203e53;strokeWidth=3;fillColor=#fff7e5;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="180" y="547.8" width="740" height="260" as="geometry"/></mxCell><mxCell id="p1n4" value="Show permission,&#xa;validation or conflict&#xa;message to the user." style="shape=parallelogram;fixedSize=1;size=36;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=27;fontStyle=0;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="1035" y="607.39" width="410" height="140.82" as="geometry"/></mxCell><mxCell id="p1n5" value="End · No change saved" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=27;fontStyle=1;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="1035" y="801.21" width="410" height="100" as="geometry"/></mxCell><mxCell id="p1n6" value="Calculate totals; enforce precision,&#xa;version and operation UUID; validate&#xa;private receipt object when supplied." style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=30;fontStyle=0;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="170" y="860.8" width="760" height="151.8" as="geometry"/></mxCell><mxCell id="p1n7" value="Save purchase ledger and line history&#xa;atomically. Do not change stock levels." style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=30;fontStyle=0;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="170" y="1065.6" width="760" height="120" as="geometry"/></mxCell><mxCell id="p1n8" value="Ledger committed?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=28;fontStyle=1;strokeColor=#203e53;strokeWidth=3;fillColor=#fff7e5;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="180" y="1238.6" width="740" height="260" as="geometry"/></mxCell><mxCell id="p1n9" value="Show validation /&#xa;conflict error; reload&#xa;ledger before retry." style="shape=parallelogram;fixedSize=1;size=36;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=27;fontStyle=0;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="1035" y="1298.1899999999998" width="410" height="140.82" as="geometry"/></mxCell><mxCell id="p1n10" value="End · Purchase not saved" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=27;fontStyle=1;strokeColor=#203e53;strokeWidth=3;fillColor=#ffffff;fontColor=#162e40;" vertex="1" parent="1"><mxGeometry x="1035" y="1492.0099999999998" width="410" 